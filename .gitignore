# Logs
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# TypeScript build info (incremental compilation cache)
*.tsbuildinfo

# XcodeGen is the source of truth for the iPad project.
apps/ipad/*.xcodeproj/
apps/ipad/build/
apps/ipad/.derived-data/
**/xcuserdata/

# Local Makelet access credentials. These are generated for class operations
# and must never enter source control.
.studio-class-codes/
.studio-smoke-token

# Browser acceptance screenshots are local verification artefacts.
/output/playwright/
