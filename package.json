{
  "name": "tapplet",
  "version": "0.1.0",
  "description": "Create tiny interactive tapplets for any lesson.",
  "private": true,
  "workspaces": [
    "services/api"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "api:dev": "npm run dev -w @tinkercademy/tapplet-api",
    "api:build": "npm run build -w @tinkercademy/tapplet-api",
    "api:test": "npm run test -w @tinkercademy/tapplet-api",
    "api:typecheck": "npm run typecheck -w @tinkercademy/tapplet-api",
    "api:db:migrate:local": "npm run db:migrate:local -w @tinkercademy/tapplet-api",
    "test": "node --test scripts/class-access.test.mjs scripts/examples.test.mjs scripts/live-image-fixture.test.mjs evals/model/artifact-eval.test.mjs apps/website/site.test.mjs",
    "website:test": "node --test apps/website/site.test.mjs",
    "verify": "npm test && npm run api:test && npm run api:typecheck && npm run eval:typecheck && npm run examples:validate && npm run eval:artifacts && npm run eval:model:test && npm run eval:browser:test",
    "examples:package": "node scripts/examples.mjs package",
    "examples:validate": "node scripts/examples.mjs validate",
    "examples:import": "node scripts/examples.mjs import",
    "examples:verify-production": "node scripts/examples.mjs parity",
    "eval:artifacts": "tsx evals/artifacts/run.ts",
    "eval:typecheck": "tsc --project evals/tsconfig.json",
    "eval:model": "tsx evals/model/run.ts",
    "eval:model:test": "tsx --test evals/model/production-harness.test.ts evals/model/run.test.ts",
    "eval:model-moderation": "tsx evals/model/moderation.ts",
    "eval:browser": "tsx evals/browser/run.ts",
    "eval:browser:test": "tsx --test evals/browser/evaluate.test.ts",
    "verify:live": "tsx scripts/verify-live-api.ts",
    "class-access:provision": "node scripts/provision-class-access.mjs",
    "class-access:shorten": "node scripts/shorten-class-access.mjs",
    "ipad:generate": "cd apps/ipad && xcodegen generate"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "jsdom": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "parse5": "^7.3.0",
    "playwright": "^1.62.1",
    "tsx": "^4.21.0"
  }
}
