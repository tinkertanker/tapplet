{
  "name": "tapplet",
  "version": "0.1.0",
  "description": "Create tiny interactive tapplets for any lesson.",
  "private": true,
  "workspaces": [
    "services/api"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "api:dev": "npm run dev -w @tinkercademy/tapplet-api",
    "api:build": "npm run build -w @tinkercademy/tapplet-api",
    "api:test": "npm run test -w @tinkercademy/tapplet-api",
    "api:typecheck": "npm run typecheck -w @tinkercademy/tapplet-api",
    "api:db:migrate:local": "npm run db:migrate:local -w @tinkercademy/tapplet-api",
    "test": "node --test scripts/class-access.test.mjs scripts/examples.test.mjs evals/model/artifact-eval.test.mjs",
    "verify": "npm test && npm run api:test && npm run api:typecheck && npm run examples:validate && npm run eval:artifacts",
    "examples:package": "node scripts/examples.mjs package",
    "examples:validate": "node scripts/examples.mjs validate",
    "examples:import": "node scripts/examples.mjs import",
    "eval:artifacts": "tsx evals/artifacts/run.ts",
    "eval:model": "tsx evals/model/run.ts",
    "eval:model-moderation": "tsx evals/model/moderation.ts",
    "verify:live": "tsx scripts/verify-live-api.ts",
    "class-access:provision": "node scripts/provision-class-access.mjs",
    "ipad:generate": "cd apps/ipad && xcodegen generate"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0"
  }
}
